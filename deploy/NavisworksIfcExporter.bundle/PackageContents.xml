<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk Application Bundle manifest for the Navisworks IFC Exporter.

  Install model: place the whole "NavisworksIfcExporter.bundle" folder into one
  of the ApplicationPlugins directories and Navisworks auto-discovers it:
    - All users:    %PROGRAMDATA%\Autodesk\ApplicationPlugins\
    - Current user: %APPDATA%\Autodesk\ApplicationPlugins\
  This is the same mechanism Autodesk App Store add-ins use.

  Navisworks version (series) codes:
    Nw19 = 2022 | Nw20 = 2023 | Nw21 = 2024 | Nw22 = 2025
  Platform codes:
    NAVMAN = Navisworks Manage | NAVSIM = Navisworks Simulate

  SeriesMin/SeriesMax below say "2022 and later". Autodesk recommends pinning a
  real SeriesMax to the newest version you have actually tested, to avoid
  surprises if a future release breaks the API. Bump it as you validate.

  Keep UpgradeCode STABLE across releases; change ProductCode per release.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="Navisworks"
    ProductType="Application"
    Name="Navisworks IFC Exporter"
    AppVersion="0.1.0"
    Description="Adds Export to IFC (IFC4 / IFC2x3) to Navisworks."
    Author="Your Name"
    AppNameSpace="appstore.exchange.autodesk.com"
    ProductCode="{4F2C8E1A-7B3D-4C9E-A1F6-2D5B8C3E9A47}"
    UpgradeCode="{9A1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D}"
    SupportedLocales="Enu">

  <CompanyDetails
      Name="Your Company"
      Url="https://example.com"
      Email="you@example.com" />

  <!-- 2022..2025+ all load the same DLL. Split into multiple <Components> with
       different ModuleName paths only if you ship per-version builds. -->
  <Components Description="Navisworks 2022 and later">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN|NAVSIM" SeriesMin="Nw19" SeriesMax="Nw99" />
    <ComponentEntry
        AppName="NavisworksIfcExporter"
        Version="0.1.0"
        ModuleName="./Contents/NavisworksIfcExporter.dll"
        AppDescription="Navisworks IFC Exporter" />
  </Components>

</ApplicationPackage>
