<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NavisworksIfcExporter</AssemblyName>
    <RootNamespace>NavisworksIfcExporter</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Navisworks is 64-bit only -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Output a flat folder (no \net48\ subfolder) so the deploy step is simpler -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Set NavisworksDir to your install folder if it differs.
    You can also pass it on the command line:  msbuild /p:NavisworksDir="C:\..."
  -->
  <PropertyGroup>
    <NavisworksDir Condition="'$(NavisworksDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2022</NavisworksDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- xBIM Toolkit: pulls in Xbim.Common + Xbim.Ifc2x3 + Xbim.Ifc4 -->
    <PackageReference Include="Xbim.Essentials" Version="5.1.341" />
  </ItemGroup>

  <ItemGroup>
    <!-- Navisworks managed API. CopyLocal=false: these ship with Navisworks. -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!--
    Convenience: deploy straight into the Navisworks Plugins folder for local
    testing (folder name must match the DLL name). Opt in with:
      /p:DeployToNavisworks=true   (optionally /p:NavisworksDir=...)
    Needs write access to the Navisworks install dir (run VS / MSBuild as admin).
    For a distributable installer, use build/build-installer.ps1 instead.
  -->
  <Target Name="DeployBundle" AfterTargets="Build" Condition="'$(DeployToNavisworks)' == 'true'">
    <PropertyGroup>
      <PluginDir>$(NavisworksDir)\Plugins\NavisworksIfcExporter</PluginDir>
      <BundleSource>$(MSBuildProjectDirectory)\..\..\deploy\NavisworksIfcExporter.bundle</BundleSource>
    </PropertyGroup>
    <ItemGroup>
      <BundleBinaries Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.config"
                      Exclude="$(TargetDir)Autodesk.Navisworks.*.dll" />
      <BundleResources Include="$(BundleSource)\Contents\Resources\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleBinaries)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="@(BundleResources)" DestinationFolder="$(PluginDir)\Resources\%(RecursiveDir)" />
    <Message Importance="high" Text="Deployed plugin to $(PluginDir)" />
  </Target>

</Project>
